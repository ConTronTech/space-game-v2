// PXN V10 racing wheel (USB 11ff:3245). ONE device: steering, the pedals that plug into the wheel base, the stick shifter and the wheel buttons.
// VERIFIED 2026-09-21 with `joytest --guided` on the laptop (user pressed each control; result in logs/joytest_guided.json). See docs/CONTROLLERS.md.
//
// Steering: axis 0, full range -32768..+32767, centre ~0. The wheel has a rotation-lock switch on the back (120 or 270 degrees; it was at 120 when recorded):
// at 120 degrees the same range covers half the turn, so raise "deadzone"/lower "scale" if it feels twitchy.
// Pedals: they REST at the minimum end (-32768) and go to +32767 when pressed ("rest": "min"), so an unpressed pedal reads 0 and a fully pressed one 1.
//   axis 2 = throttle, axis 5 = brake, axis 6 = clutch. Axes 1, 3 and 4 never carried the recorded controls (axis 4 moved during the tests: unknown, left unmapped).
// Buttons (all chosen by the user in the guided run): 0 fire, 1 next weapon (a wheel has ONE weapon switch: weapon_next cycles blaster / mining beam / missiles),
// 3 warp, 8 camera, 9 orbit lock, 12 game menu, 13 dock. Paddles (4 left, 5 right) and the hat are free for the stick shifter / later use.
{
  "name": "PXN V10 Wheel",
  "status": "VERIFIED 2026-09-21 (guided run); the stick shifter is not connected yet",
  "match": { "vid": "11ff", "pid": "3245", "name_contains": "PXN" },

  "axes": [
    { "index": 0, "role": "steering", "action": "yaw",    "invert": true, "deadzone": 0.03, "curve": 1.5 },   // wheel right (+) -> turn right (yaw + = left, so invert)
    { "index": 2, "role": "throttle", "action": "thrust", "rest": "min", "deadzone": 0.02 },                  // unpressed -32768, pressed +32767
    { "index": 5, "role": "brake",    "action": "brake",  "rest": "min", "deadzone": 0.02 },
    { "index": 6, "role": "clutch",   "action": "lift",   "rest": "min", "deadzone": 0.02, "scale": -1 }      // clutch pressed -> lift down
  ],

  "buttons": [
    { "index": 0,  "action": "fire" },
    { "index": 1,  "action": "weapon_next" },
    { "index": 3,  "action": "toggle_warp" },
    { "index": 8,  "action": "camera_next" },
    { "index": 9,  "action": "toggle_orbit_lock" },
    { "index": 12, "action": "toggle_menu" },
    { "index": 13, "action": "dock" }
  ],

  // Shifter gears (when connected): buttons will appear as extra numbers; map them with `./joytest --guided --steps=...` or add "groups" (docs/CONTROLLERS.md).
  "hats": [ { "index": 0 } ]
}
